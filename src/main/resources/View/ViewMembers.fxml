<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #B6CBD6;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ViewMembersController">
   <children>
      <Label layoutX="174.0" layoutY="22.0" text="View Members">
         <font>
            <Font name="System Bold" size="36.0" />
         </font>
      </Label>
      <Button fx:id="btnSearch" layoutX="278.0" layoutY="110.0" mnemonicParsing="false" onAction="#btnSearchOnAction" text="Search 🔎" />
      <Button fx:id="btnRefresh" layoutX="360.0" layoutY="110.0" mnemonicParsing="false" onAction="#btnRefreshOnAction" text="Refresh" />
      <TextField fx:id="txtSearch" layoutX="30.0" layoutY="109.0" prefHeight="26.0" prefWidth="229.0" promptText="Search by Name or ID" />
      <TableView fx:id="tblMembers" layoutX="30.0" layoutY="163.0" prefHeight="200.0" prefWidth="379.0">
        <columns>
          <TableColumn fx:id="colID" prefWidth="75.0" text="Member ID" />
          <TableColumn fx:id="colName" prefWidth="75.0" text="Name" />
            <TableColumn fx:id="colEmail" prefWidth="75.0" text="Email" />
            <TableColumn fx:id="colContact" prefWidth="75.0" text="Contact" />
            <TableColumn fx:id="colAddress" prefWidth="75.0" text="Address" />
        </columns>
      </TableView>
      <Button fx:id="btnAddMember" layoutX="465.0" layoutY="174.0" mnemonicParsing="false" onAction="#btnAddMemberOnAction" prefHeight="26.0" prefWidth="116.0" text="Add Member" />
      <Button fx:id="btnUpdateMember" layoutX="465.0" layoutY="215.0" mnemonicParsing="false" onAction="#btnUpdateMemberOnAction" prefHeight="26.0" prefWidth="116.0" text="Update Member" />
      <Button fx:id="btnDelete" layoutX="465.0" layoutY="255.0" mnemonicParsing="false" onAction="#btnDeleteOnAction" prefHeight="26.0" prefWidth="116.0" text="Delete Member" />
      <Button fx:id="btnBack" layoutX="465.0" layoutY="299.0" mnemonicParsing="false" onAction="#btnBackOnAction" text="Back to Dashboard" />
   </children>
</AnchorPane>
